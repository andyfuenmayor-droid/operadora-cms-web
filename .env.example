# ==============================================================================
# OPERADORA CMS / MULTIBANCA EXPRESS - CONFIGURACIÓN DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL Propia (DigitalOcean Droplet / Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=admin_db
POSTGRES_PASSWORD=tu_password_seguro_aqui
POSTGRES_DB=operadora_production
POSTGRES_PORT=5432

# Cadena de conexión interna entre contenedores Docker (red 'internal_network')
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Cadena de conexión externa (para DBeaver, TablePlus, psql o scripts desde tu máquina local / host)
# Reemplaza 'localhost' por la IP pública de tu Droplet si te conectas vía túnel SSH o IP directa
DATABASE_URL_EXTERNAL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 2. Origen de Migración (Supabase Cloud)
# ------------------------------------------------------------------------------
# Pega aquí tu Connection String de Supabase (Session Pooler o Direct Connection)
SUPABASE_DB_URI=postgresql://postgres.envojryuxdmcamlolkgp:[TU_PASSWORD_SUPABASE]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Claves heredadas de Supabase (si aplica transición progresiva)
VITE_SUPABASE_URL=https://envojryuxdmcamlolkgp.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# ------------------------------------------------------------------------------
# 3. Servidor de Pagos API REST (Node.js)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
PAYMENTS_API_KEY=mbe_live_7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c
